<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SoEx.Hosting.Dapr</PackageId>
    <Version>0.0.0-alpha-1.0</Version>
    <Authors>Blair Moir</Authors>
    <PackageProjectUrl>https://github.com/BlairMoir/SoEx/tree/primary/Library</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BlairMoir/SoEx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Dapr.AspNetCore" Version="1.14.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net.Grpc" Version="1.1.1" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.1.1" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore.Reflection" Version="1.1.1" />
    <PackageReference Include="SoEx.Container" Version="0.0.0-alpha-1.0" />
    <PackageReference Include="SoEx.Context.Abstractions" Version="0.0.0-alpha-1.0" />
    <PackageReference Include="SoEx.Interceptors.Grpc" Version="0.0.0-alpha-1.0" />
    <PackageReference Include="SoEx.Context" Version="0.0.0-alpha-1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>