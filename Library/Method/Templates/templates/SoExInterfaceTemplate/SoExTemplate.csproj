<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="$(SolutionName).Common.Identifier" />
    <Using Include="$(SolutionName).Common.Value" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Common\Identifier\$(SolutionName).Common.Identifier.csproj" />
    <ProjectReference Include="$(SolutionDir)\Common\Value\$(SolutionName).Common.Value.csproj" />
  </ItemGroup>

<!--#if( enforceDesign ) -->
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.0.0" />
      <PackageReference Include="SoEx.Method.Analyzer" Version="1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime;build;native;analyzers;buildtransitive</IncludeAssets>
      </PackageReference>
  </ItemGroup>
    <PropertyGroup>
        <ProjectName>$(MSBuildProjectName)</ProjectName>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ProjectName" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(SolutionDir)\modelanalyzer.json" />
    </ItemGroup>
    <PropertyGroup>
        <WarningsAsErrors>PCV001</WarningsAsErrors>
        <NoWarn>CS8618</NoWarn>
    </PropertyGroup>
<!--#endif -->
</Project>
